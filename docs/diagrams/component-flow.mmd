flowchart LR
  subgraph entrypoints["Entry points"]
    direction TB
    init["ffmpeg_dailies.__init__<br/>render()"]
    cli["ffmpeg_dailies.cli / __main__<br/>CLI parsing + dispatch"]
    gui_main["ffmpeg_dailies.gui.__main__<br/>launches Uvicorn app"]
  end

  subgraph core["Core pipeline"]
    direction LR
    config["config.py<br/>parse YAML into typed settings"]
    models["models.py<br/>DailiesContext + config dataclasses"]
    utils["utils.py<br/>resolve input • metadata • timecode • reel"]
    filters["filtergraph.py<br/>slate • PIP • scaling • burn-ins • OCIO"]
    execute["execute.py<br/>validate filters • build command • run ffmpeg"]
  end

  subgraph gui["GUI service"]
    direction TB
    app["gui/app.py<br/>state API • save API • preview API"]
  end

  ffmpeg["FFmpeg / ffprobe"]
  files[("Config + media + templates")]
  deliverable[("Rendered output")]

  cli --> init
  init --> config
  init --> utils
  config --> models
  utils --> models
  models --> filters
  filters --> execute
  execute --> ffmpeg
  files --> config
  files --> utils
  ffmpeg --> deliverable

  gui_main --> app
  app --> config
  app --> utils
  app --> execute
  app --> files

  classDef entry fill:#7c3aed,stroke:#e9d5ff,color:#faf5ff,stroke-width:2px;
  classDef core fill:#0f766e,stroke:#99f6e4,color:#ecfeff,stroke-width:2px;
  classDef gui fill:#2563eb,stroke:#bfdbfe,color:#eff6ff,stroke-width:2px;
  classDef ext fill:#1e40af,stroke:#93c5fd,color:#eff6ff,stroke-width:2px;
  classDef out fill:#059669,stroke:#a7f3d0,color:#ecfdf5,stroke-width:2px;

  class init,cli,gui_main entry;
  class config,models,utils,filters,execute core;
  class app gui;
  class ffmpeg,files ext;
  class deliverable out;
